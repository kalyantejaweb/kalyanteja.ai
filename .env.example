# Copy the names into the Vercel project environment. Do not commit real values.
# The reviews endpoint reads these on the server only.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Optional. Successful responses are cached for this many seconds. Default 3600.
GOOGLE_REVIEWS_CACHE_SECONDS=3600

# Used by Vercel Cron to refresh reviews. Generate a long random string.
CRON_SECRET=
